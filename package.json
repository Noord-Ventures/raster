{
  "name": "raster-monorepo",
  "private": true,
  "version": "0.4.0",
  "description": "Raster — a monochrome, CSS-first design system. Tokens, components, CLI, registry, and docs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noord-Ventures/raster.git"
  },
  "homepage": "https://getraster.com",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "postcss": ">=8.5.23"
    }
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "build:registry": "pnpm --filter @noorddev/raster build:registry",
    "test": "pnpm -r --filter './packages/*' test",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "size": "node scripts/size-budget.mjs",
    "smoke": "node scripts/smoke-tarball.mjs",
    "dev": "pnpm --filter www dev"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18",
    "@biomejs/biome": "^2.5.12",
    "publint": "^0.3"
  }
}
