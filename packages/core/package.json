{
  "name": "@noord/raster",
  "version": "0.3.0",
  "description": "Raster core — design tokens, component registry, and CSS. Monochrome, CSS-first, zero dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rennvaldes/raster.git",
    "directory": "packages/core"
  },
  "homepage": "https://raster.noord.dev",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": "./tokens/raster.tokens.json",
    "./css": "./css/raster.css",
    "./css/*": "./css/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "css",
    "tokens"
  ],
  "scripts": {
    "build:css": "node --experimental-strip-types scripts/build.mjs",
    "build:registry": "node --experimental-strip-types scripts/build-registry.mjs",
    "build": "npm run build:css && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
