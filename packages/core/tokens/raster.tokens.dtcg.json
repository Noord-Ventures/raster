{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Raster design tokens. https://getraster.com",
  "color": {
    "$description": "Monochrome. Paper, ink, gray. No accent hue.",
    "light": {
      "paper": {
        "$type": "color",
        "$value": "#FAF8F2",
        "$description": "Page ground. --bg"
      },
      "ink": {
        "$type": "color",
        "$value": "#1A1A1A",
        "$description": "Text and marks. --text"
      },
      "gray": {
        "$type": "color",
        "$value": "#6B6B6B",
        "$description": "Secondary text. --text-secondary"
      },
      "divider": {
        "$type": "color",
        "$value": "rgba(0,0,0,0.08)",
        "$description": "Hairline. --divider"
      },
      "divider-subtle": {
        "$type": "color",
        "$value": "rgba(0,0,0,0.06)",
        "$description": "Fills only. --divider-subtle"
      },
      "grid-line": {
        "$type": "color",
        "$value": "rgba(0,0,0,0.04)",
        "$description": "Module grid ink. --grid-line"
      },
      "table-alt": {
        "$type": "color",
        "$value": "rgba(0,0,0,0.02)",
        "$description": "Alternate row. --table-alt"
      },
      "control-border": {
        "$type": "color",
        "$value": "rgba(0,0,0,0.42)",
        "$description": "Form control boundary, 3:1. --control-border"
      },
      "control-fill": {
        "$type": "color",
        "$value": "#E4E2DC",
        "$description": "Hover fill of a ghost control. --control-fill"
      }
    },
    "dark": {
      "paper": {
        "$type": "color",
        "$value": "#0E0C0A",
        "$description": "--bg"
      },
      "ink": {
        "$type": "color",
        "$value": "#E8E8E8",
        "$description": "--text"
      },
      "gray": {
        "$type": "color",
        "$value": "#949494",
        "$description": "--text-secondary"
      },
      "divider": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.10)",
        "$description": "--divider"
      },
      "divider-subtle": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.07)",
        "$description": "--divider-subtle"
      },
      "grid-line": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.05)",
        "$description": "--grid-line"
      },
      "table-alt": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.03)",
        "$description": "--table-alt"
      },
      "control-border": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.38)",
        "$description": "--control-border"
      },
      "control-fill": {
        "$type": "color",
        "$value": "#242220",
        "$description": "--control-fill"
      }
    },
    "neutral": {
      "0": {
        "$type": "color",
        "$value": "#1A1A1A"
      },
      "1": {
        "$type": "color",
        "$value": "#3D3D3D"
      },
      "2": {
        "$type": "color",
        "$value": "#6B6B6B"
      },
      "3": {
        "$type": "color",
        "$value": "#949494"
      },
      "4": {
        "$type": "color",
        "$value": "#C4C2BD"
      },
      "5": {
        "$type": "color",
        "$value": "#E8E8E8"
      },
      "6": {
        "$type": "color",
        "$value": "#FAF8F2"
      }
    }
  },
  "grid": {
    "module": {
      "$type": "dimension",
      "$value": {
        "value": 204,
        "unit": "px"
      },
      "$description": "--grid-size"
    },
    "column": {
      "$type": "dimension",
      "$value": {
        "value": 184,
        "unit": "px"
      }
    },
    "gutter": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      },
      "$description": "--gutter"
    },
    "pad": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      },
      "$description": "--pad"
    }
  },
  "radius": {
    "small": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      },
      "$description": "--radius-sm, aliased by --radius"
    },
    "chrome": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      },
      "$description": "--radius-chrome"
    }
  },
  "control": {
    "desktop": {
      "hit": {
        "$type": "dimension",
        "$value": {
          "value": 40,
          "unit": "px"
        },
        "$description": "--hit"
      },
      "height": {
        "$type": "dimension",
        "$value": {
          "value": 40,
          "unit": "px"
        },
        "$description": "--control-h"
      },
      "font": {
        "$type": "dimension",
        "$value": {
          "value": 14,
          "unit": "px"
        },
        "$description": "--control-fs"
      },
      "label": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "px"
        },
        "$description": "--control-label"
      }
    },
    "phone": {
      "hit": {
        "$type": "dimension",
        "$value": {
          "value": 44,
          "unit": "px"
        }
      },
      "height": {
        "$type": "dimension",
        "$value": {
          "value": 44,
          "unit": "px"
        }
      },
      "font": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "label": {
        "$type": "dimension",
        "$value": {
          "value": 15,
          "unit": "px"
        }
      }
    }
  },
  "breakpoint": {
    "mobileGrid": {
      "$type": "dimension",
      "$value": {
        "value": 480,
        "unit": "px"
      }
    },
    "mobileLayout": {
      "$type": "dimension",
      "$value": {
        "value": 640,
        "unit": "px"
      }
    },
    "rail": {
      "$type": "dimension",
      "$value": {
        "value": 1024,
        "unit": "px"
      }
    },
    "wide": {
      "$type": "dimension",
      "$value": {
        "value": 1440,
        "unit": "px"
      }
    },
    "cap": {
      "$type": "dimension",
      "$value": {
        "value": 1700,
        "unit": "px"
      }
    }
  },
  "z": {
    "raised": {
      "$type": "number",
      "$value": 10,
      "$description": "--z-raised"
    },
    "sticky": {
      "$type": "number",
      "$value": 100,
      "$description": "--z-sticky"
    },
    "float": {
      "$type": "number",
      "$value": 200,
      "$description": "--z-float"
    },
    "overlay": {
      "$type": "number",
      "$value": 300,
      "$description": "--z-overlay"
    },
    "toast": {
      "$type": "number",
      "$value": 400,
      "$description": "--z-toast"
    }
  },
  "motion": {
    "snap": {
      "$type": "duration",
      "$value": {
        "value": 120,
        "unit": "ms"
      },
      "$description": "--duration-snap"
    },
    "ease": {
      "$type": "duration",
      "$value": {
        "value": 180,
        "unit": "ms"
      },
      "$description": "--duration"
    },
    "confirm": {
      "$type": "duration",
      "$value": {
        "value": 160,
        "unit": "ms"
      },
      "$description": "--duration-confirm"
    },
    "easing": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0,
        0,
        1
      ],
      "$description": "--ease"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "system-ui",
        "sans-serif"
      ]
    },
    "weight": {
      "body": {
        "$type": "fontWeight",
        "$value": 500
      },
      "heading": {
        "$type": "fontWeight",
        "$value": 600
      }
    }
  }
}
