{
  "name": "@noorddev/raster-react",
  "version": "0.3.0",
  "description": "Raster React components: precompiled StyleX on Raster tokens. Import the package and one stylesheet; no compiler to configure.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noord-Ventures/raster.git",
    "directory": "packages/react"
  },
  "homepage": "https://getraster.com",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": {
      "types": "./dist/raster-react.css.d.ts",
      "default": "./dist/raster-react.css"
    },
    "./stylex": {
      "types": "./dist/tokens.stylex.d.ts",
      "default": "./src/tokens.stylex.ts"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noorddev/raster": "workspace:^",
    "@stylexjs/stylex": "^0.19.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.8",
    "@babel/preset-react": "^7",
    "@babel/preset-typescript": "^7",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18.18"
  }
}
